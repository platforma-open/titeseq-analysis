{
  "name": "@platforma-open/platforma-open.titeseq-analysis.software",
  "version": "2.1.2",
  "description": "Block Software",
  "files": [
    "./dist/**/*"
  ],
  "type": "module",
  "scripts": {
    "do-pack": "shx rm -f *.tgz && block-tools software build && pnpm pack && shx mv platforma-open*.tgz package.tgz",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build": "block-tools software build",
    "deps:export": "bash scripts/deps-export.sh"
  },
  "devDependencies": {
    "@platforma-open/milaboratories.runenv-python-3": "catalog:",
    "@platforma-sdk/block-tools": "catalog:"
  },
  "block-software": {
    "artifacts": {
      "py-archive": {
        "type": "python",
        "registry": "platforma-open",
        "environment": "@platforma-open/milaboratories.runenv-python-3:3.12.10-scientific-slim",
        "dependencies": {
          "toolset": "pip",
          "requirements": "requirements.txt"
        },
        "root": "./src"
      }
    },
    "entrypoints": {
      "fit-curves": {
        "binary": {
          "artifact": "py-archive",
          "cmd": [
            "python",
            "{pkg}/main.py"
          ]
        }
      }
    }
  }
}
