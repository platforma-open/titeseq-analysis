// Column specs for the amino-acid grain: one row per amino-acid variant, combined over its synonymous
// nucleotide variants. Headers match the software's per_variant.tsv.

ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
text := import("text")

COUNT_NAME := "pl7.app/vdj/kdNtVariants"
CLASS_NAME := "pl7.app/vdj/variantClass"
CLASS_VALUES := ["wildtype", "synonymous", "nonproductive", "1 nonsynonymous", ">1 nonsynonymous"]
COUNT_STATE := "pl7.app/vdj/kdNtVariantState"
SYNONYM_SD_ALL_NAME := "pl7.app/vdj/kdLog10SynonymSdAll"

column := func(header, spec) {
	return { column: header, id: "aa_" + header, spec: spec }
}

// Empty where the class is unknown: a variant with no mutation count, or an nt variant with no single
// amino-acid variant.
classColumn := func(blockId, id, description) {
	return {
		column: "variantClass",
		id: id,
		allowNA: true,
		naRegex: "",
		spec: {
			name: CLASS_NAME,
			valueType: "String",
			domain: { "pl7.app/block": blockId },
			annotations: {
				"pl7.app/label": "Variant class",
				"pl7.app/description": description,
				"pl7.app/isScore": "false",
				"pl7.app/isDiscreteFilter": "true",
				"pl7.app/discreteValues": "[\"wildtype\",\"synonymous\",\"nonproductive\",\"1 nonsynonymous\",\">1 nonsynonymous\"]",
				"pl7.app/table/visibility": "optional",
				"pl7.app/table/orderPriority": "184"
			}
		}
	}
}

countColumn := func(header, blockId, state, label, description, visibility, priority) {
	domain := { "pl7.app/block": blockId }
	// The total carries no state, so its domain is the Kd,app columns' and a downstream block can
	// pair the two.
	if !is_undefined(state) {
		domain[COUNT_STATE] = state
	}
	return column(header, {
		name: COUNT_NAME,
		valueType: "Int",
		domain: domain,
		annotations: {
			"pl7.app/label": label,
			"pl7.app/description": description,
			"pl7.app/isScore": "false",
			"pl7.app/table/visibility": visibility,
			"pl7.app/table/orderPriority": priority
		}
	})
}

KD_DESCRIPTION := "Kd,app of the amino-acid variant: 10 to the mean log10 Kd,app of its synonymous nucleotide variants, each fitted on its own. The mean is unweighted. A variant censored at the edge of the titration enters at that edge."

KD_REPLICATES_DESCRIPTION := "Kd,app of the amino-acid variant: 10 to the mean log10 Kd,app across the replicates. In each replicate the value is the unweighted mean log10 Kd,app of the variant's synonymous nucleotide variants, each fitted on its own. A nucleotide variant or a replicate censored at the edge of the titration enters at that edge. Replicates below range and Replicates above range give the number of such replicates."

SE_DESCRIPTION := "Standard error of the mean log10 Kd,app. With two or more synonymous nucleotide variants, the larger of two terms: their spread, the SD over the square root of their number; and their fit error. The fit error is the root mean square of their own fit SEs over the square root of their number, where the equation reports a fit SE; one with no fit SE, such as one at an edge of the range, counts at the typical error of the others. With one variant, its own fit SE where the equation reports one. Empty for a bound and for a failed variant. At or below 0.5, Kd,app is rated Good."

COUNT_SUM_NOTE := "With sample replicates, this is summed over the replicates: a nucleotide variant counts once in each replicate it was fitted in, so the states can add up to more than the NT variants column."

FAILURE_DESCRIPTION := "Why the amino-acid variant gets the rating Failed. all_variants_failed: none of its synonymous nucleotide variants has a Kd,app. conflicting_censoring: they sit at opposite edges of the range with no edge holding most of them. not_productive: the variant has a stop codon or a frame shift. Empty for other ratings."

FAILURE_REPLICATES_DESCRIPTION := "Why the amino-acid variant gets the rating Failed. all_replicates_failed: no replicate has a Kd,app. conflicting_censoring: the replicates sit at opposite edges of the range with no edge holding most of them. not_productive: the variant has a stop codon or a frame shift. Empty for other ratings."

SD_DESCRIPTION := "SD of log10 Kd,app across the synonymous nucleotide variants in the mean: their spread alone, with no fit error. Empty with fewer than two variants, for a bound and for a failed variant."

// The reads the fits used, on the grain whose ids start with `idPrefix`.
fitReadsColumn := func(blockId, idPrefix, description) {
	return {
		column: "fitReads",
		id: idPrefix + "fitReads",
		spec: {
			name: "pl7.app/vdj/fitReads",
			valueType: "Long",
			domain: { "pl7.app/block": blockId },
			annotations: {
				"pl7.app/label": "Reads in fit",
				"pl7.app/description": description,
				"pl7.app/isScore": "false",
				"pl7.app/table/visibility": "optional",
				"pl7.app/table/orderPriority": "189"
			}
		}
	}
}

// The parent delta and its error, on the grain whose ids start with `idPrefix`.
deltaColumns := func(blockId, idPrefix, description) {
	domain := { "pl7.app/block": blockId }
	return [{
		column: "kdLog10ParentDelta",
		id: idPrefix + "kdLog10ParentDelta",
		spec: {
			name: "pl7.app/vdj/kdLog10ParentDelta",
			valueType: "Double",
			domain: domain,
			annotations: {
				"pl7.app/label": "Kd,app vs Parent (log10)",
				"pl7.app/description": description,
				"pl7.app/isScore": "false",
				"pl7.app/format": "+.2f",
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "183"
			}
		}
	}, {
		// Error of the value above, on the same axes.
		column: "kdLog10ParentDeltaSe",
		id: idPrefix + "kdLog10ParentDeltaSe",
		spec: {
			name: "pl7.app/vdj/kdLog10ParentDeltaSe",
			valueType: "Double",
			domain: domain,
			annotations: {
				"pl7.app/label": "Kd,app vs Parent SE (log10)",
				"pl7.app/description": "The variant's and the parent's SE added in quadrature. Empty where either has none. The parent's own row is 0.",
				"pl7.app/isScore": "false",
				"pl7.app/format": ".2f",
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "182"
			}
		}
	}]
}

/**
 * @param blockId: the block id stamped into every domain, as on the nucleotide grain
 * @param kdAnnotations: the nucleotide grain's Kd,app annotations, unit included
 * @param opts: {parentMode, variantClass, affinityClassValues, affinityClassCutoff, boundRule,
 *   kdNegLog10Spec, replicateColumns}; parentMode emits the parent delta and its error,
 *   variantClass emits the class column, kdNegLog10Spec the -log10 column, and replicateColumns
 *   replaces the synonymous SE and SD with the replicates' error columns
 * @return xsv column descriptors. Table order: the Kd,app columns (orderPriority 185 to 202), then
 *   the DMS columns (176 to 184).
 */
variantColumns := func(blockId, kdAnnotations, opts) {
	domain := { "pl7.app/block": blockId }
	// With replicates the caller passes the replicate error columns, and every count by state is
	// summed over the replicates: the synonymous variants are fitted again in each one.
	replicates := !is_undefined(opts.replicateColumns)
	countDescription := func(description) {
		if !replicates {
			return description
		}
		return description + " " + COUNT_SUM_NOTE
	}
	// The caller's bound rule names the members of a combined value as replicates. Without
	// replicates the members here are the synonymous variants.
	boundRule := replicates ? opts.boundRule : text.replace(opts.boundRule, "its replicates", "its synonymous variants", -1)
	classDescription := replicates ?
		"The class of the value combined over the replicates, after the synonymous nucleotide variants are combined inside each replicate. Good: the standard error across the replicates is 0.5 or less, more than half the replicates were measured inside the range, and in more than half the replicates, more than half the synonymous variants in the mean were measured inside the range. Under the mean bin fit, which reports no fit SE, more than half the replicates must also be rated Good on their own. Partial: the standard error is more than 0.5, or a majority is missing. " +
			boundRule + " Failed: no replicate has a Kd,app, or the replicates sit at opposite edges with neither edge holding most of them. With one replicate and no standard error, the value keeps that replicate's class." :
		"The class of the value combined over the synonymous nucleotide variants. Good: the standard error is 0.5 or less, and more than half the variants were measured inside the range. Under the mean bin fit, which reports no fit SE, more than half the variants must also be rated Good on their own. Partial: the standard error is more than 0.5, or a majority is missing. " +
			boundRule + " Failed: no nucleotide variant has a Kd,app, or the variants sit at opposite edges with neither edge holding most of them. A single variant with no standard error keeps its own class."
	outOfRangeDescription := replicates ?
		"True when no replicate measured Kd,app inside the titrated range and more of them sit at one edge than at the other, so Kd,app is that edge." :
		"True when no nucleotide variant in the mean was measured inside the titrated range and more of them sit at one edge than at the other, so Kd,app is that edge."
	// With replicates the SE and SD are the replicates' spread, and the counts come with them: the
	// caller passes those columns in `opts.replicateColumns`. Without them the SE and SD are the
	// synonymous variants' own.
	errorColumns := replicates ? opts.replicateColumns : [
		// Error of the Kd,app value, on the same axes.
		column("kdLog10Se", {
			name: "pl7.app/vdj/kdLog10Se",
			valueType: "Double",
			domain: domain,
			annotations: {
				"pl7.app/label": "Kd,app SE (log10)",
				"pl7.app/description": SE_DESCRIPTION,
				"pl7.app/isScore": "true",
				"pl7.app/score/rankingOrder": "increasing",
				"pl7.app/format": ".2f",
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "200"
			}
		}),
		// Not `kdLog10Sd`: that name is the spread across replicates, on every grain.
		column("kdLog10Sd", {
			name: SYNONYM_SD_ALL_NAME,
			valueType: "Double",
			domain: domain,
			annotations: {
				"pl7.app/label": "Kd,app SD across synonymous variants, edges included (log10)",
				"pl7.app/description": SD_DESCRIPTION,
				"pl7.app/isScore": "false",
				"pl7.app/format": ".2f",
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "199"
			}
		})
	]
	cols := [
		column("kd", {
			name: "pl7.app/vdj/kd",
			valueType: "Double",
			domain: domain,
			annotations: maps.merge(kdAnnotations, {
				"pl7.app/description": replicates ? KD_REPLICATES_DESCRIPTION : KD_DESCRIPTION
			})
		}),
		column("affinityClass", {
			name: "pl7.app/vdj/affinityClass",
			valueType: "String",
			domain: domain,
			annotations: {
				"pl7.app/label": "Affinity class",
				"pl7.app/description": classDescription,
				"pl7.app/isScore": "true",
				"pl7.app/isDiscreteFilter": "true",
				// The equation's own classes, as on the nucleotide grain, so one filter fits both.
				"pl7.app/discreteValues": opts.affinityClassValues,
				"pl7.app/score/rankingOrder": "decreasing",
				"pl7.app/score/defaultCutoff": opts.affinityClassCutoff,
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "202"
			}
		}),
		column("fitFailureReason", {
			name: "pl7.app/vdj/fitFailureReason",
			valueType: "String",
			domain: domain,
			annotations: {
				"pl7.app/label": "Fit failure reason",
				"pl7.app/description": replicates ? FAILURE_REPLICATES_DESCRIPTION : FAILURE_DESCRIPTION,
				"pl7.app/isScore": "false",
				"pl7.app/table/visibility": "optional",
				"pl7.app/table/orderPriority": "197"
			}
		}),
		// The software writes "true"/"false"; xsv.importFile admits no Boolean valueType.
		column("kdOutOfRange", {
			name: "pl7.app/vdj/kdOutOfRange",
			valueType: "String",
			domain: domain,
			annotations: {
				"pl7.app/label": "Kd,app out of range",
				"pl7.app/description": outOfRangeDescription,
				"pl7.app/isScore": "false",
				"pl7.app/isDiscreteFilter": "true",
				"pl7.app/discreteValues": "[\"true\",\"false\"]",
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "196"
			}
		}),
		countColumn("ntVariants", blockId, undefined, "NT variants",
			"Synonymous nucleotide variants of this amino-acid variant that were fitted." + (replicates ? " A variant fitted in several replicates counts once." : ""), "default", "181"),
		countColumn("ntMeasured", blockId, "measured", "NT variants measured",
			countDescription("Nucleotide variants whose Kd,app lies inside the titrated range."), "optional", "180"),
		countColumn("ntCensoredBelow", blockId, "censoredBelow", "NT variants censored low",
			countDescription("Nucleotide variants whose Kd,app is at or below the lowest concentration. Each enters the mean at that concentration."),
			"optional", "179"),
		countColumn("ntCensoredAbove", blockId, "censoredAbove", "NT variants censored high",
			countDescription("Nucleotide variants whose Kd,app is at or above the highest concentration. Each enters the mean at that concentration."),
			"optional", "178"),
		countColumn("ntFailed", blockId, "failed", "NT variants failed",
			countDescription("Nucleotide variants rated Failed. They are left out of the mean."), "optional", "177")
	]
	// The synonymous variants' spread over the ones measured in range, on every run. With
	// replicates the kdLog10Sd header is the replicates' spread.
	cols = append(cols, column("kdLog10SynonymSd", {
		name: "pl7.app/vdj/kdLog10SynonymSd",
		valueType: "Double",
		domain: domain,
		annotations: {
			"pl7.app/label": "Kd,app SD across synonymous variants, measured in range only (log10)",
			"pl7.app/description": "SD of log10 Kd,app across the synonymous nucleotide variants measured inside the titrated range; with sample replicates, each combined over the replicates first. Bound and failed variants are left out. Empty with fewer than two.",
			"pl7.app/isScore": "false",
			"pl7.app/format": ".2f",
			"pl7.app/table/visibility": "optional",
			"pl7.app/table/orderPriority": "176"
		}
	}))
	cols = cols + errorColumns
	if !is_undefined(opts.kdNegLog10Spec) {
		cols = append(cols, column("kdNegLog10", opts.kdNegLog10Spec))
	}
	cols = append(cols, fitReadsColumn(blockId, "aa_",
		"The reads the fits of this amino-acid variant's synonymous nucleotide variants used, every replicate included: sorted samples only, at the non-zero concentrations that pass the read floor. A nucleotide variant that was not fitted adds none."))
	if opts.variantClass {
		cols = append(cols, classColumn(blockId, "aa_variantClass",
			"nonproductive: the amino-acid variant has a stop codon or a frame shift, and has no Kd,app. Otherwise by its amino-acid mutation count: wildtype 0, 1 nonsynonymous 1, >1 nonsynonymous more."))
	}
	if opts.parentMode {
		cols = cols + deltaColumns(blockId, "aa_",
			"log10 Kd,app of this amino-acid variant minus that of its parent. A variant censored at the edge of the titration reads from that edge, so its delta is a bound and its error is empty. Negative binds tighter than the parent, the opposite sign to a delta of log10 K_A. The parent's own row is 0.")
	}
	return cols
}

/**
 * Column specs for the nucleotide grain's synonymous columns, one row per fitted nt variant. Headers
 * match the software's per_nt_variant.tsv.
 *
 * @param blockId: the block id stamped into every domain
 * @param opts: {variantClass, parentMode}
 * @return xsv column descriptors
 */
ntVariantColumns := func(blockId, opts) {
	cols := []
	if opts.variantClass {
		cols = append(cols, classColumn(blockId, "nt_variantClass",
			"The class of the nucleotide variant's amino-acid variant: nonproductive, 1 nonsynonymous or >1 nonsynonymous. Under an unmutated amino-acid variant, wildtype with no nucleotide mutation and synonymous with some. A variant that is not productive keeps its own fit."))
	}
	if opts.parentMode {
		cols = cols + deltaColumns(blockId, "nt_",
			"log10 Kd,app of this nucleotide variant minus that of its parent's unmutated nucleotide variant. A variant censored at the edge of the titration reads from that edge. Negative binds tighter than the parent, the opposite sign to a delta of log10 K_A. The parent's own row is 0.")
	}
	return cols
}

export ll.toStrict({
	COUNT_NAME: COUNT_NAME,
	COUNT_STATE: COUNT_STATE,
	SYNONYM_SD_ALL_NAME: SYNONYM_SD_ALL_NAME,
	CLASS_NAME: CLASS_NAME,
	CLASS_VALUES: CLASS_VALUES,
	variantColumns: variantColumns,
	ntVariantColumns: ntVariantColumns,
	fitReadsColumn: fitReadsColumn
})
